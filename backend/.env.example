# Copy this file to .env and fill in your own values. Never commit .env.

# Server
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=amber_alert_db
# Database used by "npm test" (created automatically). Defaults to <DB_NAME>_test.
# TEST_DB_NAME=amber_alert_db_test

# Login tokens: use a long random value, e.g. from
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Public address used in shared alert links (e.g. a Cloudflare tunnel https://....trycloudflare.com).
# Leave empty to use the address the request came in on (works on your own Wi-Fi only).
PUBLIC_BASE_URL=

# Email invitations (Gmail: smtp.gmail.com, port 465, and a Google "app password", not the account password).
# Leave SMTP_HOST empty to skip sending emails; the invitation code still shows in the app.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LocalAlert <your.address@gmail.com>"

# Optional
# ESCALATION_INTERVAL_MINUTES=360   # time between escalation levels (set 2 to test quickly)
# UPLOAD_DIR=uploads                # where photos and ID documents are saved
