# Copy this file to .env (in the frontend folder). Never commit .env.

# Optional: force the app to use this backend address, e.g. http://192.168.1.10:5000/api
# Leave unset to use the computer running Expo, on port 5000 (same Wi-Fi).
# EXPO_PUBLIC_API_URL=

# Backend address used when the app is opened through "npm run remote" (Expo tunnel),
# e.g. the localtunnel address from "npm run tunnel" in the backend folder.
EXPO_PUBLIC_REMOTE_API_URL=https://localalert-sdmodise.loca.lt/api
