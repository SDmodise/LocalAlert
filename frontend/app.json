{
  "name": "LocalAlert",
  "slug": "localalert",
  "scheme": "localalert",
  "version": "1.0.0",
  "orientation": "portrait",
  "userInterfaceStyle": "light",
  "icon": "./assets/icon.png",
  "splash": {
    "image": "./assets/splash-icon.png",
    "resizeMode": "contain",
    "backgroundColor": "#1559D6"
  },
  "ios": {
    "supportsTablet": false,
    "bundleIdentifier": "com.localalert.app"
  },
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "monochromeImage": "./assets/adaptive-icon-monochrome.png",
      "backgroundColor": "#1559D6"
    },
    "package": "com.localalert.app",
    "googleServicesFile": "./google-services.json",
    "permissions": [
      "android.permission.ACCESS_COARSE_LOCATION",
      "android.permission.ACCESS_FINE_LOCATION",
      "android.permission.RECORD_AUDIO",
      "android.permission.CAMERA"
    ]
  },
  "web": {
    "favicon": "./assets/favicon.png"
  },
  "plugins": [
    "expo-asset",
    [
      "expo-location",
      {
        "locationWhenInUsePermission": "LocalAlert uses your location to find your municipality so you receive alerts for people missing near you. Only the municipality is saved."
      }
    ],
    [
      "expo-image-picker",
      {
        "cameraPermission": "LocalAlert uses the camera to take photos for family profiles and sighting reports.",
        "photosPermission": "LocalAlert uses your photos to add pictures to family profiles and sighting reports."
      }
    ],
    [
      "expo-camera",
      {
        "cameraPermission": "LocalAlert uses the camera to scan family QR codes and take photos."
      }
    ],
    "expo-status-bar",
    [
      "expo-notifications",
      {
        "icon": "./assets/notification-icon.png",
        "color": "#1559D6",
        "defaultChannel": "alerts"
      }
    ]
  ],
  "extra": {
    "eas": {
      "projectId": "7f53ccd6-733e-49bb-9dea-8312a61c0a94"
    }
  },
  "owner": "zionc"
}
